# MongoDB Atlas / local connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_hospital?retryWrites=true&w=majority

# JWT Authentication secret key
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed CORS Origins (comma-separated, default "*")
ALLOWED_ORIGINS=*

# Server Port (default 8000)
PORT=8000
